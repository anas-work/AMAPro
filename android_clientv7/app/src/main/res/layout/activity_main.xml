<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fitsSystemWindows="false">

    <!-- Full-screen content with WindowInsets handling in code -->
    <LinearLayout
        android:id="@+id/rootContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 1. Top Executive App Bar -->
        <LinearLayout
            android:id="@+id/headerBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg_secondary"
            android:orientation="vertical">

            <!-- Header Content Row -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/headerContent"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <!-- Corporate Brand Identity -->
                <LinearLayout
                    android:id="@+id/brandContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/imgBrandShield"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_shield_corp"
                        android:contentDescription="AMAPro Shield" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvLogo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:letterSpacing="0.04"
                                android:text="AMA"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:letterSpacing="0.04"
                                android:text="PRO"
                                android:textColor="@color/accent_green"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.12"
                            android:text="ENTERPRISE AI"
                            android:textColor="@color/text_muted"
                            android:textSize="8sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Staff Directory Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenEmployees"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="12dp"
                    android:text="STAFF"
                    android:textColor="@color/accent_cyan"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/accent_cyan_dim"
                    app:cornerRadius="10dp"
                    app:icon="@drawable/ic_badge_staff"
                    app:iconSize="16dp"
                    app:iconTint="@color/accent_cyan"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btnOpenEnroll"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:ignore="SmallSp" />

                <!-- Enroll Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenEnroll"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="12dp"
                    android:text="ENROLL"
                    android:textColor="@color/accent_green"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/accent_green_dim"
                    app:cornerRadius="10dp"
                    app:icon="@drawable/ic_user_add_corp"
                    app:iconSize="16dp"
                    app:iconTint="@color/accent_green"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btnModeToggle"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:ignore="SmallSp" />

                <!-- Mode Toggle Capsule -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnModeToggle"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="76dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/label_entry"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/accent_green"
                    app:cornerRadius="10dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:ignore="SmallSp" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Header Bottom Hairline Border -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_color" />
        </LinearLayout>

        <!-- 2. Main Content (Camera + Dashboard Feed) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Camera Viewport (42% height) -->
            <FrameLayout
                android:id="@+id/cameraContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.42"
                android:background="#000000">

                <androidx.camera.view.PreviewView
                    android:id="@+id/previewView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:implementationMode="compatible"
                    app:scaleType="fillCenter" />

                <!-- Frozen Frame when Camera is Paused/Switched Off -->
                <ImageView
                    android:id="@+id/imgPausedFrame"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <com.aimonk.attendance.engine.OverlayView
                    android:id="@+id/overlayView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Floating Live Controls (Top Right) -->
                <LinearLayout
                    android:id="@+id/layoutCameraLiveControls"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="12dp"
                    android:orientation="horizontal">

                    <!-- Flip Camera -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFlipCamera"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="8dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="12dp"
                        android:text="Flip"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:backgroundTint="#CC0F1A2D"
                        app:strokeColor="#FF2A3B59"
                        app:strokeWidth="1dp"
                        app:cornerRadius="10dp"
                        app:icon="@drawable/ic_camera_flip_corp"
                        app:iconSize="16dp"
                        app:iconTint="@color/text_primary" />

                    <!-- Pause/Resume Camera -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCameraPauseResume"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="12dp"
                        android:text="Pause"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:backgroundTint="#CC0F1A2D"
                        app:strokeColor="#FF2A3B59"
                        app:strokeWidth="1dp"
                        app:cornerRadius="10dp"
                        app:icon="@drawable/ic_camera_pause_corp"
                        app:iconSize="16dp"
                        app:iconTint="@color/text_primary" />
                </LinearLayout>

                <!-- Live Stream Indicator Badge (Bottom Left) -->
                <LinearLayout
                    android:id="@+id/layoutCameraStatusIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_pill_unknown"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp">

                    <TextView
                        android:id="@+id/tvCameraLiveBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:text="● LIVE"
                        android:textColor="@color/accent_red"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Camera Offline / Sensor Inactive Overlay -->
                <FrameLayout
                    android:id="@+id/cameraStartOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#F2080C14"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="visible">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="28dp">

                        <ImageView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:src="@drawable/ic_sensor_offline"
                            android:contentDescription="Camera Sensor" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Camera Sensor Inactive"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Initiate live biometric recognition feed"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnStartCamera"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_marginTop="18dp"
                            android:background="@drawable/bg_button_corporate_primary"
                            android:paddingStart="22dp"
                            android:paddingEnd="24dp"
                            android:text="START CAMERA FEED"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:cornerRadius="12dp"
                            app:icon="@drawable/ic_camera_play_corp"
                            app:iconSize="16dp"
                            app:iconTint="@color/white" />
                    </LinearLayout>
                </FrameLayout>

            </FrameLayout>

            <!-- 3. Dashboard and Activity Feed (58% height) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.58"
                android:background="@color/bg_dark"
                android:orientation="vertical">

                <!-- Executive KPI Metrics Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp">

                    <!-- Present KPI Tile -->
                    <LinearLayout
                        android:id="@+id/boxPresent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:background="@drawable/bg_kpi_present"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="10dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_stat_present"
                                android:contentDescription="Present Icon" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:letterSpacing="0.08"
                                android:text="@string/label_present"
                                android:textColor="@color/accent_green_bright"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvPresentCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif-black"
                            android:text="0"
                            android:textColor="@color/accent_green"
                            android:textSize="24sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Absent KPI Tile -->
                    <LinearLayout
                        android:id="@+id/boxAbsent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp"
                        android:background="@drawable/bg_kpi_absent"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="10dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_stat_absent"
                                android:contentDescription="Absent Icon" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:letterSpacing="0.08"
                                android:text="@string/label_absent"
                                android:textColor="@color/accent_cyan"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvAbsentCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif-black"
                            android:text="0"
                            android:textColor="@color/accent_cyan"
                            android:textSize="24sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Unknown KPI Tile -->
                    <LinearLayout
                        android:id="@+id/boxUnknown"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/bg_kpi_unknown"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="10dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_stat_unknown"
                                android:contentDescription="Unknown Icon" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:letterSpacing="0.08"
                                android:text="@string/label_unknown"
                                android:textColor="@color/accent_red"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvUnknownCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif-black"
                            android:text="0"
                            android:textColor="@color/accent_red"
                            android:textSize="24sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Activity Feed Header Controls -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <!-- Live Feed Title -->
                    <TextView
                        android:id="@+id/tvFeedLiveStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.06"
                        android:text="@string/label_live_feed"
                        android:textColor="@color/accent_green"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- Stop/Resume Feed Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStopResumeFeed"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="6dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="@string/action_stop"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        app:backgroundTint="@color/border_color"
                        app:cornerRadius="8dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/btnFlushFeed"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:ignore="SmallSp" />

                    <!-- Flush Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFlushFeed"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="Flush"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        app:backgroundTint="@color/border_color"
                        app:cornerRadius="8dp"
                        app:icon="@drawable/ic_flush_sweep"
                        app:iconSize="14dp"
                        app:iconTint="@color/text_secondary"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:ignore="SmallSp" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Segmented Filter Tabs Container -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="horizontal"
                    android:padding="3dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tabFilterAll"
                        style="@style/Widget.Material3.Button.UnelevatedButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="ALL"
                        android:textColor="@color/white"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/accent_green"
                        app:cornerRadius="8dp"
                        tools:ignore="SmallSp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tabFilterCheckIn"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="CHECK-IN"
                        android:textColor="@color/text_secondary"
                        android:textSize="9sp"
                        app:cornerRadius="8dp"
                        tools:ignore="SmallSp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tabFilterCheckOut"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="CHECK-OUT"
                        android:textColor="@color/text_secondary"
                        android:textSize="9sp"
                        app:cornerRadius="8dp"
                        tools:ignore="SmallSp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tabFilterUnknown"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="UNKNOWN"
                        android:textColor="@color/accent_red"
                        android:textSize="9sp"
                        app:cornerRadius="8dp"
                        tools:ignore="SmallSp" />

                </LinearLayout>

                <!-- Activity Feed RecyclerView with Cascading Entrance Animation -->
                <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                    android:id="@+id/swipeRefresh"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvActivityFeed"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clipToPadding="false"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="16dp"
                            android:layoutAnimation="@anim/layout_animation_fall_down"
                            tools:listitem="@layout/item_activity_card" />

                        <!-- Empty Feed Slate State -->
                        <LinearLayout
                            android:id="@+id/emptyFeedContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <ImageView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:src="@drawable/ic_empty_feed"
                                android:contentDescription="Empty Feed" />

                            <TextView
                                android:id="@+id/tvEmptyFeed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:letterSpacing="0.04"
                                android:text="No activity records yet"
                                android:textColor="@color/text_muted"
                                android:textSize="13sp" />

                        </LinearLayout>

                    </FrameLayout>
                </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
