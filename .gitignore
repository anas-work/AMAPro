*.db
*.sqlite
*.sqlite3
data/attendance.db
data/attendance_captures/
data/enrolled_photos/
data/embeddings/
data/enrollment_reports/
n_verbose/

# ── Employee media (PII — never commit) ──────────────────────────────────────
Employees_Photo/
Employees_Video/

# ── Frontend build output & node_modules ─────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/

