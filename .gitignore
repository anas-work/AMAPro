# ── Large ML model binaries (track only ONNX sources, not compiled engines) ───
*.engine           # TensorRT compiled engines (GPU-arch specific, must recompile)
*.trt

# Models exceeding GitHub's 100MB limit — download separately (see README)
models/kprpe_adaface.onnx     # 167MB — AdaFace KPRPe recognition model

